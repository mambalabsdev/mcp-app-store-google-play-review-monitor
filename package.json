{
  "name": "@mambalabsdev/mcp-app-store-google-play-review-monitor",
  "version": "1.0.0",
  "description": "MCP server for App Store and Google Play Review Monitor. App Store and Google Play reviews by country store, newest first, only new ones on a schedule, plus a rating trend row per app. Runs on Apify. Clay-ready output.",
  "type": "module",
  "bin": {
    "mcp-app-store-google-play-review-monitor": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "app-reviews",
    "app-store",
    "google-play",
    "review-monitoring",
    "ios",
    "android",
    "apify",
    "clay"
  ],
  "author": "Mamba Labs <labs@mambamindsetgrowth.com>",
  "license": "MIT",
  "homepage": "https://apify.com/mambalabs/app-store-google-play-review-monitor",
